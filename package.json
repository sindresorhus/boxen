{
	"name": "boxen",
	"version": "8.0.1",
	"description": "Create boxes in the terminal",
	"license": "MIT",
	"repository": "sindresorhus/boxen",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": {
		"name": "Sindre Sorhus",
		"email": "sindresorhus@gmail.com",
		"url": "https://sindresorhus.com"
	},
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "xo && node --test --experimental-test-snapshots --experimental-test-coverage --test-coverage-include=index.js && tsd"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"cli",
		"box",
		"boxes",
		"terminal",
		"term",
		"console",
		"ascii",
		"unicode",
		"border",
		"text"
	],
	"dependencies": {
		"ansi-align": "^3.0.1",
		"chalk": "^5.3.0",
		"cli-boxes": "^3.0.0",
		"slice-ansi": "^7.1.2",
		"string-width": "^7.2.0",
		"type-fest": "^4.21.0",
		"widest-line": "^5.0.0",
		"wrap-ansi": "^9.0.0"
	},
	"devDependencies": {
		"tsd": "^0.31.1",
		"xo": "^0.58.0"
	},
	"xo": {
		"rules": {
			"@typescript-eslint/no-unsafe-assignment": "off",
			"unicorn/import-style": "off",
			"ava/no-import-test-files": "off",
			"import/no-unassigned-import": [
				"error",
				{
					"allow": [
						"**/tests/setup.js"
					]
				}
			]
		}
	}
}
