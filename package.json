{
	"name": "boxen",
	"version": "8.0.1",
	"description": "Create boxes in the terminal",
	"license": "MIT",
	"repository": "sindresorhus/boxen",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": "Sindre Sorhus <sindresorhus@gmail.com> (https://sindresorhus.com)",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "xo && node --test --experimental-test-snapshots --experimental-test-coverage --test-coverage-include=index.js && tsd"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"cli",
		"box",
		"boxes",
		"terminal",
		"term",
		"console",
		"ascii",
		"unicode",
		"border",
		"text"
	],
	"dependencies": {
		"chalk": "^6.0.0",
		"cli-boxes": "^4.0.1",
		"slice-ansi": "^9.0.1",
		"string-width": "^8.2.2",
		"type-fest": "^5.10.0",
		"widest-line": "^6.0.0",
		"wrap-ansi": "^10.0.1"
	},
	"devDependencies": {
		"tsd": "^0.33.0",
		"xo": "^5.0.1"
	},
	"xo": {
		"rules": {
			"@typescript-eslint/no-unsafe-assignment": "off",
			"unicorn/import-style": "off",
			"ava/no-import-test-files": "off",
			"import-x/no-unassigned-import": [
				"error",
				{
					"allow": [
						"**/tests/setup.js"
					]
				}
			],
			"no-control-regex": "off",
			"regexp/no-control-character": "off",
			"regexp/prefer-named-capture-group": "off"
		}
	}
}
